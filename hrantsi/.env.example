# ---------- Մուտք (Google) ----------
# Գաղտնի բանալի՝ ստեղծիր `npx auth secret` հրամանով կամ ցանկացած երկար պատահական տեքստ
AUTH_SECRET=
# Google OAuth՝ https://console.cloud.google.com/apis/credentials
# Redirect URI՝ https://ՔՈ-ԿԱՅՔԸ/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Տվյալների բազա (Postgres, օր․՝ Neon) ----------
# https://neon.tech → New project → Connection string
DATABASE_URL=

# ---------- Կրեդիտներ և վճարում ----------
# Ադմինների email-ները (ստորակետով)՝ նրանք տեսնում են «Ադմին» բաժինը
ADMIN_EMAILS=qo-email@gmail.com
# Վճարման տվյալներ, որ տեսնում են գնորդները
HRANTSI_PAY_INFO=Idram ID՝ 000000000
HRANTSI_CONTACT=
# Գրանցման նվեր և զրույցի օրական սահմանաչափ
# HRANTSI_FREE_CREDITS=5
# HRANTSI_CHAT_DAILY_LIMIT=30
# Փաթեթներ (դրամով)
# HRANTSI_PACKS=[{"credits":20,"price":1500},{"credits":60,"price":4000},{"credits":150,"price":9000}]
# Գործողությունների արժեքը կրեդիտով
# HRANTSI_COST_IMAGE=1
# HRANTSI_COST_EDIT=1
# HRANTSI_COST_VIDEO=10
# HRANTSI_COST_UPSCALE=1
# HRANTSI_COST_REMOVE_BG=1

# ---------- AI ծառայություններ ----------
# Claude — զրույցի և պրոմպտների բարելավման համար
# Ստանալ՝ https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Replicate — նկարի, խմբագրման, վիդեոյի և գործիքների համար
# Ստանալ՝ https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# (Ըստ ցանկության) Մոդելների փոխարինում։ Ձևաչափ՝ owner/name կամ owner/name:version
# HRANTSI_MODEL_IMAGE=black-forest-labs/flux-1.1-pro-ultra
# HRANTSI_MODEL_EDIT=black-forest-labs/flux-kontext-pro
# HRANTSI_MODEL_VIDEO=minimax/hailuo-02
# HRANTSI_MODEL_UPSCALE=recraft-ai/recraft-crisp-upscale
# HRANTSI_MODEL_REMOVE_BG=bria/remove-background
